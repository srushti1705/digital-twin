# Local frontend origins, comma-separated.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render Free Web Services have an ephemeral filesystem. These paths are
# intentionally under /tmp and are repopulated on startup.
CLIMATE_DATA_ROOT=/tmp/climate-data
CLIMATE_MODEL_DIR=/tmp/climate-models
CLIMATE_METRICS_DIR=/tmp/climate-metrics
IMD_RAINFALL_DIR=/tmp/climate-data/rainfall
IMD_TEMPERATURE_DIR=/tmp/climate-data

# The deployment bootstrap downloads official annual grids for these years.
IMD_DATA_YEARS=2025
CLIMATE_MODEL_BUNDLE_URL=
PORT=8000
