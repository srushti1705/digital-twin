# Local frontend origins, comma-separated.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render Free Web Services have an ephemeral filesystem. These paths are
# intentionally under /tmp and are repopulated on startup.
CLIMATE_DATA_ROOT=/tmp/climate-data
CLIMATE_MODEL_DIR=/tmp/climate-models
CLIMATE_METRICS_DIR=/tmp/climate-metrics
IMD_RAINFALL_DIR=/tmp/climate-data/rainfall
IMD_TEMPERATURE_DIR=/tmp/climate-data

# The deployment bootstrap downloads official annual grids for these years.
IMD_DATA_YEARS=2025
CLIMATE_MODEL_BUNDLE_URL=
PORT=8000

# ==============================================================================
# LIVE CLIMATE DATA INGESTION CONFIGURATION
# ==============================================================================
# Official IMD API (https://api.imd.gov.in/public/api_reference.html)
# Leave blank if not registered; service reports status as 'credentials_required'
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/v1

# NASA Earthdata / GPM IMERG numerical access (https://urs.earthdata.nasa.gov)
# Required for numerical IMERG HDF5/NetCDF ingestion. Visual GIBS WMS layers require no key.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Supplementary Weather Cache TTL (seconds) for Open-Meteo NWP assimilation feeds
OPEN_METEO_CACHE_TTL_SECONDS=900
